# AppArmor profile for ingressd (deny-by-default confinement).
#
# Optional companion to the systemd seccomp/capability hardening. Install to
# /etc/apparmor.d/ingressd (deploy/install.sh does this when apparmor_parser is
# present) and enable confinement by setting `AppArmorProfile=ingressd` in the
# systemd unit. The path below must match the binary (unit uses /usr/bin/ingressd).
#include <tunables/global>

profile ingressd /usr/bin/ingressd flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  # AF_PACKET raw capture + loopback metrics listener.
  network packet,
  network raw,
  network inet stream,
  network inet dgram,
  network inet6 stream,
  network inet6 dgram,

  # The only privilege ingressd needs for capture. Add net_admin ONLY for enforcement.
  capability net_raw,
  # capability net_admin,

  # Binary (mm = memory map exec).
  /usr/bin/ingressd mr,

  # Read config, write state + logs, read listener set + host routing.
  /etc/ingressd/**                r,
  /var/lib/ingressd/**             rw,
  /var/log/ingressd/**            rw,
  /proc/net/tcp                   r,
  /proc/net/tcp6                  r,
  /proc/net/route                 r,
  /proc/net/dev                   r,
  /etc/resolv.conf                r,
  /etc/localtime                  r,
  /etc/hosts                      r,
  /dev/urandom                    r,
  /dev/null                       rw,
  /dev/zero                       rw,
  /dev/random                     r,

  # Syslog socket (only used when [sinks].syslog=true).
  /dev/log                        w,

  # nft is invoked only when active response is enabled; drop this line if you
  # never enable [enforce].
  /usr/sbin/nft                   ixr,
  /usr/bin/nft                    ixr,

  # Deny broad host access the daemon has no reason to touch.
  deny @{PROC}/**/mem w,
  deny write /etc/**,
  deny write /usr/**,
  deny write /root/**,
  deny write /home/**,
}
