# Normalize line endings so Linux-runnable files are always LF in the repo.
* text=auto

# Must be LF: these run on the Linux target.
*.sh        text eol=lf
*.service   text eol=lf
*.rules     text eol=lf
*.conf      text eol=lf

# Source and config: normalize, no forced worktree EOL.
*.rs        text
*.toml      text
*.yaml      text
*.yml       text
*.json      text
*.md        text
Dockerfile  text

# Binary — never touch.
*.pcap      binary
*.mmdb      binary
